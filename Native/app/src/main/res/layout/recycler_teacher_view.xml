<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:elevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_conner_with_border"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_tn"
                android:layout_width="105dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:text="Name : " />

            <TextView
                android:id="@+id/tv_teacher_name"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_toRightOf="@+id/tv_tn"
                android:gravity="center_vertical"
                android:text="Teacher Name " />

            <Button
                android:id="@+id/btn_edit_teacher"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/icon_edit_24"
                android:drawableTint="@color/PrimaryColor"
                android:padding="16dp" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Phone : " />

            <TextView
                android:id="@+id/tv_teacher_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:text="Phone No " />

            <Button
                android:id="@+id/btn_delete_teacher"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_delete_24"
                android:drawableTint="@color/PrimaryColor"
                android:padding="16dp" />

        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>