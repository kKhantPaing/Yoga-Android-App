<!-- res/layout/layout_filter_options.xml -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/popup_card_bottom_radius"
        android:orientation="vertical"
        android:padding="8dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/et_teacher_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teacher Name" />

        <RadioGroup
            android:id="@+id/rg_filter_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/PrimaryColor"
                android:checked="true"
                android:text="By Day" />

            <RadioButton
                android:id="@+id/radio_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/PrimaryColor"
                android:text="By Date" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginVertical="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/sp_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/dayOfWeek"
                android:paddingEnd="4dp" />

            <Button
                android:id="@+id/btn_apply_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_conner"
                android:drawableEnd="@drawable/icon_calendar_month_24"
                android:drawableTint="@color/PrimaryColor"
                android:paddingStart="4dp"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                tools:ignore="RtlSymmetry" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_apply_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_conner_with_border"
                android:text="Clear"
                android:textColor="@color/DarkColor" />

            <Button
                android:id="@+id/btn_apply_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_conner"
                android:backgroundTint="@color/PrimaryColor"
                android:text="Filter"
                android:textColor="@color/SecondaryColor" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
